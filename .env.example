# 알림 서버 설정 — 서버의 .env 에 복사해 값을 채운다. 이 파일에는 실제 값을 적지 않는다.

BIND_ADDR=                      # 이 서버의 LAN 주소(외부 포트 16000 을 여기에만 연다)
ALERT_SECRET=                   # 사건 접수·조회용 서버 간 비밀값(ci-cd·front 와 같은 값). 비우면 전부 거절
ALERT_SETTINGS_SECRET=          # 설정 보기·시험 발송 전용 비밀값 — 어드민과 알림 서버만 갖는다. ALERT_SECRET 과 다른 값. 비우면 두 경로를 늘 거절

# --- 발송 채널: 디스코드 → 슬랙 → 메일 순서로 시도한다. 채운 것만 쓴다(하나도 없으면 뜨지 않는다)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
MAIL_USERNAME=                  # Gmail 주소
MAIL_PASSWORD=                  # Gmail 앱 비밀번호
MAIL_FROM=                      # 보내는 주소(보통 MAIL_USERNAME 과 같다)
MAIL_TO=                        # 알림을 받을 주소

# --- 감시 대상 주소(monitors.yml 이 가리킨다). 전부 있어야 뜬다
MONITOR_FRONT_URL=              # 예: http://<front 서버>:11000
MONITOR_BACKEND_URL=            # 예: http://<backend 서버>:8090
MONITOR_LLM_URL=                # 예: http://<llm 서버>:8000
MONITOR_DEPLOY_MASTER_URL=      # 예: http://<master 서버>:15000
MONITOR_DEPLOY_AGENT_FRONT_URL= # 예: http://<front 서버>:15001
MONITOR_DEPLOY_AGENT_BACKEND_URL=
MONITOR_DEPLOY_AGENT_LLM_URL=
MONITOR_OBSERVE_URL=            # 예: http://<관측 서버>:17000
MONITOR_ADMIN_URL=              # 예: http://<어드민 서버>:18000 — 어드민 nginx 가 여는 포트
